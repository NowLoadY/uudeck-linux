#!/usr/bin/env bash
# ========================================================
# 网易 UU 加速器 (Steam Deck / Linux) 管理器
# ========================================================

set -e

GREEN="\033[1;32m"
RED="\033[1;31m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
BOLD="\033[1m"
RESET="\033[0m"

show_header() {
    clear
    echo -e "${CYAN}================================================================${RESET}"
    echo -e "${BOLD}                   网易 UU 主机加速器 (Linux版)                 ${RESET}"
    echo -e "${CYAN}================================================================${RESET}"
    
    # 检查服务状态
    if systemctl is-active --quiet uuplugin; then
        local pid
        pid=$(pgrep -f "xuplugin-guardian" | head -n1 || true)
        echo -e " 服务状态: ${GREEN}● 正在运行 (Running)${RESET}  (守护进程 PID: ${pid:-正常})"
    else
        echo -e " 服务状态: ${RED}○ 已停止 (Stopped)${RESET}"
    fi

    # 获取本机内网IP
    local local_ip
    local_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "未知")
    echo -e " 本机IP:   ${BOLD}${local_ip}${RESET}"
    
    # 获取加速器配置/标识
    if [ -f "/home/uu/.uuplugin_uuid" ]; then
        echo -e " 设备UUID: $(cat /home/uu/.uuplugin_uuid 2>/dev/null)"
    elif [ -f "/home/deck/.uuplugin_uuid" ]; then
        echo -e " 设备UUID: $(cat /home/deck/.uuplugin_uuid 2>/dev/null)"
    fi
    echo -e "${CYAN}----------------------------------------------------------------${RESET}"
}

show_qrcode() {
    local qr_file="/tmp/uu/.steam_deck_sn_qrcode"
    if [ -f "$qr_file" ]; then
        echo -e "${YELLOW}【手机 App 扫码绑定】${RESET}"
        echo -e "请在手机端打开【网易UU主机加速器】App："
        echo -e " 1. 确保手机与本机连接同一 Wi-Fi / 局域网"
        echo -e " 2. 点击 App 首页右上角【+】扫码绑定"
        echo ""
        cat "$qr_file"
        echo ""
    else
        echo -e "${YELLOW}【绑定状态】${RESET}"
        if systemctl is-active --quiet uuplugin; then
            echo -e "${GREEN}加速服务正在正常运行。${RESET}"
            echo -e "• 若手机 App 已经绑定过此设备，可直接在手机 App 中选择游戏加速。"
            echo -e "• 若尚未绑定或需要换绑，请选择菜单选项 [2] 重启服务生成新绑定码。"
        else
            echo -e "加速器服务未运行，选择 [3] 启动服务后将自动生成二维码。"
        fi
        echo ""
    fi
    echo -e "${CYAN}----------------------------------------------------------------${RESET}"
}

show_menu() {
    echo -e "${BOLD}常用操作：${RESET}"
    echo -e "  ${GREEN}[1]${RESET} 刷新状态 / 重新读取二维码"
    echo -e "  ${GREEN}[2]${RESET} 重启加速器服务 (重新生成绑定码)"
    echo -e "  ${GREEN}[3]${RESET} 启动加速器服务"
    echo -e "  ${GREEN}[4]${RESET} 停止加速器服务"
    echo -e "  ${GREEN}[5]${RESET} 查看加速器运行日志"
    echo -e "  ${RED}[q]${RESET} 退出本窗口 (加速服务仍会在后台继续运行)"
    echo -e "${CYAN}----------------------------------------------------------------${RESET}"
    read -rp "请输入操作编号 [1-5, q]: " choice
}

main() {
    # 如果服务未运行，先自动拉起
    if ! systemctl is-active --quiet uuplugin; then
        echo -e "${YELLOW}正在启动网易 UU 加速器服务...${RESET}"
        sudo systemctl start uuplugin || true
        sleep 2
    fi

    while true; do
        show_header
        show_qrcode
        show_menu
        case "$choice" in
            1)
                echo -e "\n正在刷新..."
                sleep 1
                ;;
            2)
                echo -e "\n${YELLOW}正在重启加速器服务...${RESET}"
                sudo systemctl restart uuplugin || true
                echo "等待服务启动及二维码生成..."
                sleep 3
                ;;
            3)
                echo -e "\n${YELLOW}正在启动加速器服务...${RESET}"
                sudo systemctl start uuplugin || true
                sleep 2
                ;;
            4)
                echo -e "\n${YELLOW}正在停止加速器服务...${RESET}"
                sudo systemctl stop uuplugin || true
                sleep 1
                ;;
            5)
                echo -e "\n${YELLOW}按 Ctrl+C 可退出日志查看模式...${RESET}"
                sleep 1
                journalctl -u uuplugin -n 30 -f || true
                ;;
            q|Q|exit)
                echo -e "\n${GREEN}已退出管理界面。UU 加速器将在后台保持运行！${RESET}\n"
                break
                ;;
            *)
                echo -e "\n${RED}无效选项，请重新输入。${RESET}"
                sleep 1
                ;;
        esac
    done
}

main "$@"
